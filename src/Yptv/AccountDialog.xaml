<Window x:Class="Yptv.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg1}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="16">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <Grid x:Name="Rows" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        </Grid>
        <TextBlock x:Name="Note" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Fg2}"
                   Text="The playlist link contains your username and password. Share it with nobody."/>
        <DockPanel Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Close" IsCancel="True" IsDefault="True"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Refresh" Margin="0,0,8,0" Click="Refresh_Click"/>
                <Button x:Name="CopyButton" Content="Copy link" Click="Copy_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
