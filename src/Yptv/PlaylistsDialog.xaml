<Window x:Class="Yptv.PlaylistsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playlists" Width="720" Height="420" MinWidth="640" MinHeight="320" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg1}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Bg1}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="24" Background="{DynamicResource Bg2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="104"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="NAME" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="TYPE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="CHANNELS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="4" Text="REFRESHED" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"/>
                </Grid>
                <ListBox x:Name="List" Style="{StaticResource ChannelList}" ItemContainerStyle="{StaticResource ChannelItem}"
                         SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="104"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Marker}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource Acc}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Host}" FontSize="11" Foreground="{DynamicResource Fg2}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TypeText}" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding CountText}" FontFamily="{StaticResource NumFont}" FontSize="11"
                                           Foreground="{DynamicResource Fg2}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding RefreshedText}" FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <StackPanel Grid.Column="1" Width="112" Margin="16,0,0,0">
            <Button x:Name="AddButton" Content="Add…" Margin="0,0,0,4" Click="Add_Click"/>
            <Button x:Name="ActiveButton" Content="Set active" Margin="0,0,0,4" Click="Active_Click"/>
            <Button x:Name="RefreshButton" Content="Refresh now" Margin="0,0,0,4" Click="Refresh_Click"/>
            <Button x:Name="RenameButton" Content="Rename…" Margin="0,0,0,4" Click="Rename_Click"/>
            <Button x:Name="RemoveButton" Content="Remove" Margin="0,0,0,12" Click="Remove_Click"/>
            <Button x:Name="AccountButton" Content="Account…" Margin="0,0,0,4" Click="Account_Click"/>
            <Button x:Name="ExportButton" Content="Export…" Margin="0,0,0,4" Click="Export_Click"/>
            <Button x:Name="CopyButton" Content="Copy link" Click="Copy_Click"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True"/>
            <TextBlock DockPanel.Dock="Left" Text="Auto-refresh" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="AutoBox" DockPanel.Dock="Left" Width="132" SelectionChanged="Auto_Changed"/>
            <TextBlock x:Name="Message" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="12,0,12,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
