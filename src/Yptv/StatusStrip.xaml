<UserControl x:Class="Yptv.StatusStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="{DynamicResource Fg2}">
    <UserControl.Resources>
        <Style x:Key="Seg" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="Link" TargetType="TextBlock" BasedOn="{StaticResource Seg}">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Sep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{DynamicResource Div}"/>
        </Style>
    </UserControl.Resources>
    <Border Height="22" Background="{DynamicResource Bg0}" BorderBrush="{DynamicResource Hi}" BorderThickness="0,1,0,0">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="12" Style="{StaticResource Link}"
                       ToolTip="Theme" MouseLeftButtonUp="Theme_Click"/>
            <TextBlock DockPanel.Dock="Right" Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12" Style="{StaticResource Link}"
                       ToolTip="Settings (Ctrl+,)" MouseLeftButtonUp="Settings_Click"/>
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Fg3}" Margin="8,0,0,0"/>
            <TextBlock x:Name="StateText" Text="Ready" Style="{StaticResource Seg}" FontFamily="{StaticResource UiFont}" MinWidth="88"/>
            <Rectangle Style="{StaticResource Sep}"/>
            <TextBlock x:Name="VideoText" Text="—" Style="{StaticResource Seg}" MinWidth="112"/>
            <Rectangle Style="{StaticResource Sep}"/>
            <TextBlock x:Name="RateText" Text="—" Style="{StaticResource Seg}" MinWidth="56"/>
            <Rectangle Style="{StaticResource Sep}"/>
            <TextBlock x:Name="BufferText" Text="—" Style="{StaticResource Seg}" MinWidth="48"/>
            <Rectangle Style="{StaticResource Sep}"/>
            <TextBlock x:Name="CountText" Text="0 ch" Style="{StaticResource Seg}" MinWidth="56"/>
            <Rectangle Style="{StaticResource Sep}"/>
            <TextBlock x:Name="SourceText" Text="no playlist" Style="{StaticResource Seg}" FontFamily="{StaticResource UiFont}"/>
            <Rectangle x:Name="ExpirySep" Style="{StaticResource Sep}" Visibility="Collapsed"/>
            <TextBlock x:Name="ExpiryText" Style="{StaticResource Link}" FontFamily="{StaticResource NumFont}" Visibility="Collapsed"
                       ToolTip="Account details" MouseLeftButtonUp="Expiry_Click"/>
            <Rectangle x:Name="HiddenSep" Style="{StaticResource Sep}" Visibility="Collapsed"/>
            <TextBlock x:Name="HiddenText" Style="{StaticResource Link}" Visibility="Collapsed" ToolTip="Manage groups"
                       MouseLeftButtonUp="Hidden_Click"/>
        </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
