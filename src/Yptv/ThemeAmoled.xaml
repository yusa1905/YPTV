<!-- Amoled theme tokens (DESIGN.md). Same keys in every Theme*.xaml; swapped at runtime. All brushes frozen. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">
    <LinearGradientBrush x:Key="Bg2" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#161616" Offset="0"/>
        <GradientStop Color="#161616" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Bg2H" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#202020" Offset="0"/>
        <GradientStop Color="#202020" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Bg2P" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#161616" Offset="0"/>
        <GradientStop Color="#161616" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Bg0" Color="#000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="Bg1" Color="#000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="Well" Color="#080808" po:Freeze="True"/>
    <LinearGradientBrush x:Key="WellEdge" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#2A2A2A" Offset="0"/>
        <GradientStop Color="#2A2A2A" Offset="0.65"/>
        <GradientStop Color="#2A2A2A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Line" Color="#262626" po:Freeze="True"/>
    <SolidColorBrush x:Key="Hi" Color="#1C1C1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="Div" Color="#1A1A1A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Fg" Color="#E6E6E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="Fg2" Color="#9A9A9A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Fg3" Color="#6A6A6A" po:Freeze="True"/>
    <SolidColorBrush x:Key="Acc" Color="#1FD1C1" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccHi" Color="#5BE3D6" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccLo" Color="#138A80" po:Freeze="True"/>
    <LinearGradientBrush x:Key="AccBar" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#138A80" Offset="0"/>
        <GradientStop Color="#1FD1C1" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Sel" Color="#0C2724" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelDim" Color="#1A1A1A" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowHover" Color="#101010" po:Freeze="True"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#2A2A2A" po:Freeze="True"/>
    <SolidColorBrush x:Key="ThumbHover" Color="#3C3C3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="Warn" Color="#D9A441" po:Freeze="True"/>
    <SolidColorBrush x:Key="Err" Color="#E05A4F" po:Freeze="True"/>
</ResourceDictionary>
