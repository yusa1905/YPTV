<Window x:Class="Yptv.GroupsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Groups" Width="440" Height="560" MinWidth="360" MinHeight="320" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg1}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Invert" MinWidth="0" Padding="8,0" Margin="4,0,0,0" Click="Invert_Click"/>
                <Button DockPanel.Dock="Right" Content="None" MinWidth="0" Padding="8,0" Margin="4,0,0,0" Click="None_Click"/>
                <Button DockPanel.Dock="Right" Content="All" MinWidth="0" Padding="8,0" Margin="4,0,0,0" Click="All_Click"/>
                <Grid>
                    <TextBox x:Name="FilterBox" TextChanged="Filter_TextChanged"/>
                    <TextBlock Text="Filter groups" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center"
                               Margin="8,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=FilterBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
            <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Bg1}">
                <ListBox x:Name="List" Style="{StaticResource ChannelList}" ItemContainerStyle="{StaticResource ChannelItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource RowCheck}" IsChecked="{Binding Visible}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontFamily="{StaticResource NumFont}"
                                               FontSize="11" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="OK" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click"/>
                <Button Content="Cancel" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="Summary" Foreground="{DynamicResource Fg2}" FontFamily="{StaticResource NumFont}" FontSize="11"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>

