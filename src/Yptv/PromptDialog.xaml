<Window x:Class="Yptv.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg1}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="16">
        <TextBlock x:Name="Label" Foreground="{DynamicResource Fg2}" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="Input" TextChanged="Input_TextChanged"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="Ok" Content="OK" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
