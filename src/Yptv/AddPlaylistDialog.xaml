<Window x:Class="Yptv.AddPlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add playlist" Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg1}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="M3uTab" Style="{StaticResource ScopeTab}" Content="M3U (URL or file)" IsChecked="True" Checked="Tab_Checked"/>
            <RadioButton x:Name="XtreamTab" Grid.Column="1" Style="{StaticResource ScopeTab}" Content="Xtream login" Margin="-1,0,0,0" Checked="Tab_Checked"/>
        </Grid>

        <TextBlock Text="Name (optional)" Foreground="{DynamicResource Fg2}" FontSize="11" Margin="0,16,0,4"/>
        <TextBox x:Name="NameBox"/>

        <StackPanel x:Name="M3uPanel">
            <TextBlock Text="Playlist URL or file" Foreground="{DynamicResource Fg2}" FontSize="11" Margin="0,12,0,4"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Browse"
                        Margin="4,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="SourceBox" TextChanged="Field_Changed"/>
            </DockPanel>
        </StackPanel>

        <StackPanel x:Name="XtreamPanel" Visibility="Collapsed">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="88"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Server" Foreground="{DynamicResource Fg2}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="HostBox" TextChanged="Field_Changed" ToolTip="provider.example or https://provider.example"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Port" Foreground="{DynamicResource Fg2}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="PortBox" TextChanged="Field_Changed"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Username" Foreground="{DynamicResource Fg2}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="UserBox" TextChanged="Field_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Password" Foreground="{DynamicResource Fg2}" FontSize="11" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PassBox" PasswordChanged="Field_Changed"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <TextBlock x:Name="Status" Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="16" Foreground="{DynamicResource Fg2}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="Ok" Content="Add" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button x:Name="Cancel" Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
